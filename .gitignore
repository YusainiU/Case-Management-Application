*.sqlite
*.sqlite3
/database/*.sqlite
/database/*.sqlite-journal
database/*.sqlite
database/*.sqlite-journal

# Logs
*.log
/laravel.log
/browser.log
/browser.log.*
/php_errors.log
/coverage/
/var/

