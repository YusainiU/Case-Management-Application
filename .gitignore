!/storage/framework/.gitkeep
!/storage/logs/.gitkeep

# Node / frontend
/node_modules
/npm-debug.log*
/yarn-debug.log*
/yarn-error.log*
/public/build
/public/hot
/public/storage
/public/uploads
/public/media
